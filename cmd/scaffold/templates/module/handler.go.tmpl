package handler

import (
	"github.com/gofiber/fiber/v2"

	"{{ .ModulePath }}/internal/module/{{ .Name }}/dto"
	"{{ .ModulePath }}/internal/module/{{ .Name }}/usecase"
	"{{ .ModulePath }}/internal/platform/validator"
	"{{ .ModulePath }}/pkg/response"
)

// Handler handles {{ .Name }} HTTP requests.
type Handler struct {
	useCase usecase.UseCase
}

// NewHandler creates a new {{ .Name }} handler.
func NewHandler(useCase usecase.UseCase) *Handler {
	return &Handler{useCase: useCase}
}

// GetByID retrieves a {{ .Name }} by ID.
func (h *Handler) GetByID(c *fiber.Ctx) error {
	id := c.Params("id")
	result, err := h.useCase.GetByID(c.UserContext(), id)
	if err != nil {
		return response.Fail(c, err)
	}
	return response.Success(c, result)
}

// List retrieves a paginated list of {{ .Plural }}.
func (h *Handler) List(c *fiber.Ctx) error {
	var req dto.List{{ .TitlePlural }}Request
	if err := validator.ValidateQuery(c, &req); err != nil {
		return validator.HandleValidationError(c, err)
	}

	result, err := h.useCase.List(c.UserContext(), req)
	if err != nil {
		return response.Fail(c, err)
	}
	return response.Paginated(c, result.GetItems(), result.GetMeta())
}

// Create creates a new {{ .Name }}.
func (h *Handler) Create(c *fiber.Ctx) error {
	var req dto.Create{{ .Title }}Request
	if err := validator.ValidateAndBind(c, &req); err != nil {
		return validator.HandleValidationError(c, err)
	}

	result, err := h.useCase.Create(c.UserContext(), req)
	if err != nil {
		return response.Fail(c, err)
	}
	return response.Created(c, result)
}

// Update updates a {{ .Name }}.
func (h *Handler) Update(c *fiber.Ctx) error {
	id := c.Params("id")
	var req dto.Update{{ .Title }}Request
	if err := validator.ValidateAndBind(c, &req); err != nil {
		return validator.HandleValidationError(c, err)
	}

	result, err := h.useCase.Update(c.UserContext(), id, req)
	if err != nil {
		return response.Fail(c, err)
	}
	return response.Success(c, result)
}

// Delete removes a {{ .Name }}.
func (h *Handler) Delete(c *fiber.Ctx) error {
	id := c.Params("id")
	if err := h.useCase.Delete(c.UserContext(), id); err != nil {
		return response.Fail(c, err)
	}
	return response.NoContent(c)
}
