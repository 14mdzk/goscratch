type mockRepo struct {
	mock.Mock
}

var _ Repo = (*mockRepo)(nil)

func (m *mockRepo) GetByID(ctx context.Context, id string) (*domain.{{ .Title }}, error) {
	args := m.Called(ctx, id)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(*domain.{{ .Title }}), args.Error(1)
}

func (m *mockRepo) List(ctx context.Context, filter domain.{{ .Title }}Filter) ([]domain.{{ .Title }}, error) {
	args := m.Called(ctx, filter)
	return args.Get(0).([]domain.{{ .Title }}), args.Error(1)
}

func (m *mockRepo) Create(ctx context.Context, name string) (*domain.{{ .Title }}, error) {
	args := m.Called(ctx, name)
	if args.Get(0) == nil {
		return nil, args.Error(1)
