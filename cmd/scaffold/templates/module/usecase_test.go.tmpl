func (m *mockRepo) Delete(ctx context.Context, id string) error {
	return m.Called(ctx, id).Error(0)
}

type fakeTransactor struct {
	called int
}

func (f *fakeTransactor) WithTx(ctx context.Context, fn func(ctx context.Context) error) error {
	f.called++
	return fn(ctx)
}

func TestNewUseCase(t *testing.T) {
	uc := NewUseCase(&mockRepo{}, &fakeTransactor{})
	assert.NotNil(t, uc)
}

func Test{{ .Title }}UseCase_GetByID(t *testing.T) {
	ctx := context.Background()
	id := uuid.New()
	now := time.Now().UTC()

	t.Run("found", func(t *testing.T) {
		repo := new(mockRepo)
		repo.On("GetByID", ctx, id.String()).Return(&domain.{{ .Title }}{
			ID:        id,
			Name:      "sample",
			CreatedAt: now,
			UpdatedAt: now,
		}, nil)

		uc := NewUseCase(repo, &fakeTransactor{})
		resp, err := uc.GetByID(ctx, id.String())
		require.NoError(t, err)
		assert.Equal(t, id.String(), resp.ID)
		assert.Equal(t, "sample", resp.Name)
		repo.AssertExpectations(t)
	})

	t.Run("not_found", func(t *testing.T) {
		repo := new(mockRepo)
		repo.On("GetByID", ctx, id.String()).Return(nil, apperr.NotFoundf("{{ .Name }} not found"))

		uc := NewUseCase(repo, &fakeTransactor{})
		resp, err := uc.GetByID(ctx, id.String())
		assert.Nil(t, resp)
		require.Error(t, err)
		repo.AssertExpectations(t)
	})
}

func Test{{ .Title }}UseCase_List(t *testing.T) {
	ctx := context.Background()
	id := uuid.New()
	now := time.Now().UTC()

	t.Run("valid_page", func(t *testing.T) {
		repo := new(mockRepo)
		repo.On("List", ctx, mock.AnythingOfType("domain.{{ .Title }}Filter")).Return([]domain.{{ .Title }}{
			{ID: id, Name: "first", CreatedAt: now, UpdatedAt: now},
		}, nil)

		uc := NewUseCase(repo, &fakeTransactor{})
		page, err := uc.List(ctx, dto.List{{ .TitlePlural }}Request{Limit: 10})
		require.NoError(t, err)
		require.Len(t, page.GetItems(), 1)
		assert.Equal(t, id.String(), page.GetItems()[0].ID)
		repo.AssertExpectations(t)
	})

	t.Run("invalid_cursor", func(t *testing.T) {
		uc := NewUseCase(new(mockRepo), &fakeTransactor{})
		_, err := uc.List(ctx, dto.List{{ .TitlePlural }}Request{Cursor: "not-valid-base64!"})
		require.Error(t, err)
	})
}

func Test{{ .Title }}UseCase_Create(t *testing.T) {
	ctx := context.Background()
	id := uuid.New()
	now := time.Now().UTC()

	repo := new(mockRepo)
	tx := &fakeTransactor{}
	repo.On("Create", ctx, "new item").Return(&domain.{{ .Title }}{
		ID:        id,
		Name:      "new item",
		CreatedAt: now,
		UpdatedAt: now,
	}, nil)

	uc := NewUseCase(repo, tx)
	resp, err := uc.Create(ctx, dto.Create{{ .Title }}Request{Name: "new item"})
	require.NoError(t, err)
	assert.Equal(t, 1, tx.called)
	assert.Equal(t, id.String(), resp.ID)
	assert.Equal(t, "new item", resp.Name)
	repo.AssertExpectations(t)
}

func Test{{ .Title }}UseCase_UpdateAndDelete(t *testing.T) {
	ctx := context.Background()
	id := uuid.New()
	now := time.Now().UTC()

	repo := new(mockRepo)
	repo.On("Update", ctx, id.String(), "updated").Return(&domain.{{ .Title }}{
		ID:        id,
		Name:      "updated",
		CreatedAt: now,
		UpdatedAt: now,
	}, nil)
	repo.On("Delete", ctx, id.String()).Return(nil)

	uc := NewUseCase(repo, &fakeTransactor{})
	resp, err := uc.Update(ctx, id.String(), dto.Update{{ .Title }}Request{Name: "updated"})
	require.NoError(t, err)
	assert.Equal(t, "updated", resp.Name)

	require.NoError(t, uc.Delete(ctx, id.String()))
	repo.AssertExpectations(t)
}
