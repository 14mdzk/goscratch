package usecase

import (
	"context"
	"time"

	"{{ .ModulePath }}/internal/module/{{ .Name }}/domain"
	"{{ .ModulePath }}/internal/module/{{ .Name }}/dto"
	"{{ .ModulePath }}/internal/port"
	shareddomain "{{ .ModulePath }}/internal/shared/domain"
	"{{ .ModulePath }}/pkg/apperr"
)

type {{ .Name }}UseCase struct {
	repo       Repo
	transactor port.Transactor
}

var _ UseCase = (*{{ .Name }}UseCase)(nil)

// NewUseCase creates a new {{ .Name }} use case.
func NewUseCase(repo Repo, transactor port.Transactor) UseCase {
	return &{{ .Name }}UseCase{
		repo:       repo,
		transactor: transactor,
	}
}

// GetByID retrieves a {{ .Name }} record by ID.
func (uc *{{ .Name }}UseCase) GetByID(ctx context.Context, id string) (*dto.{{ .Title }}Response, error) {
	item, err := uc.repo.GetByID(ctx, id)
	if err != nil {
		return nil, err
	}
	return to{{ .Title }}Response(item), nil
}

// List retrieves a cursor-paginated list of {{ .Plural }}.
func (uc *{{ .Name }}UseCase) List(ctx context.Context, req dto.List{{ .TitlePlural }}Request) (shareddomain.CursorPage[dto.{{ .Title }}Response], error) {
	limit := shareddomain.NormalizeLimit(req.Limit)

	var cursorID string
	var direction string
	hasCursor := false

	if req.Cursor != "" {
		cursor, err := shareddomain.DecodeCursor(req.Cursor)
		if err != nil {
			return shareddomain.CursorPage[dto.{{ .Title }}Response]{}, apperr.BadRequestf("invalid cursor")
		}
		if cursor != nil {
			cursorID = cursor.LastID
			direction = string(cursor.Direction)
			hasCursor = true
		}
	}

	filter := domain.{{ .Title }}Filter{
		Cursor:    cursorID,
		Limit:     limit,
		Direction: direction,
		Search:    req.Search,
	}

	items, err := uc.repo.List(ctx, filter)
	if err != nil {
		return shareddomain.CursorPage[dto.{{ .Title }}Response]{}, err
	}

	responses := make([]dto.{{ .Title }}Response, 0, len(items))
	for i := range items {
		responses = append(responses, *to{{ .Title }}Response(&items[i]))
	}

	return shareddomain.NewBidirectionalCursorPage(responses, limit, direction, hasCursor, func(item dto.{{ .Title }}Response) *shareddomain.Cursor {
		return &shareddomain.Cursor{LastID: item.ID}
	}), nil
}

// Create creates a new {{ .Name }} inside a transaction when a transactor is configured.
func (uc *{{ .Name }}UseCase) Create(ctx context.Context, req dto.Create{{ .Title }}Request) (*dto.{{ .Title }}Response, error) {
	var item *domain.{{ .Title }}

	if uc.transactor != nil {
		if err := uc.transactor.WithTx(ctx, func(txCtx context.Context) error {
			var err error
			item, err = uc.repo.Create(txCtx, req.Name)
			return err
		}); err != nil {
			return nil, err
		}
		return to{{ .Title }}Response(item), nil
	}

	var err error
	item, err = uc.repo.Create(ctx, req.Name)
	if err != nil {
		return nil, err
	}
	return to{{ .Title }}Response(item), nil
}

// Update updates an existing {{ .Name }}.
func (uc *{{ .Name }}UseCase) Update(ctx context.Context, id string, req dto.Update{{ .Title }}Request) (*dto.{{ .Title }}Response, error) {
	item, err := uc.repo.Update(ctx, id, req.Name)
	if err != nil {
		return nil, err
	}
	return to{{ .Title }}Response(item), nil
}

// Delete removes a {{ .Name }} by ID.
func (uc *{{ .Name }}UseCase) Delete(ctx context.Context, id string) error {
	return uc.repo.Delete(ctx, id)
}

func to{{ .Title }}Response(item *domain.{{ .Title }}) *dto.{{ .Title }}Response {
	return &dto.{{ .Title }}Response{
		ID:        item.ID.String(),
		Name:      item.Name,
		CreatedAt: item.CreatedAt.Format(time.RFC3339),
		UpdatedAt: item.UpdatedAt.Format(time.RFC3339),
	}
}
