type mockUseCase struct {
	mock.Mock
}

var _ usecase.UseCase = (*mockUseCase)(nil)

func (m *mockUseCase) GetByID(ctx context.Context, id string) (*dto.{{ .Title }}Response, error) {
	args := m.Called(ctx, id)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(*dto.{{ .Title }}Response), args.Error(1)
}

func (m *mockUseCase) List(ctx context.Context, req dto.List{{ .TitlePlural }}Request) (shareddomain.CursorPage[dto.{{ .Title }}Response], error) {
	args := m.Called(ctx, req)
	return args.Get(0).(shareddomain.CursorPage[dto.{{ .Title }}Response]), args.Error(1)
}

