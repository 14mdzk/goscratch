func parseJSONBody(t *testing.T, resp *http.Response) map[string]any {
	t.Helper()
	body, err := io.ReadAll(resp.Body)
	require.NoError(t, err)
	defer resp.Body.Close()

	var result map[string]any
	require.NoError(t, json.Unmarshal(body, &result))
	return result
}

func TestNewHandler(t *testing.T) {
	h := NewHandler(&mockUseCase{})
	assert.NotNil(t, h)
}

func TestHandler_GetByID(t *testing.T) {
	t.Run("ok", func(t *testing.T) {
		uc := new(mockUseCase)
		uc.On("GetByID", mock.Anything, "id-1").Return(&dto.{{ .Title }}Response{
			ID:   "id-1",
			Name: "sample",
		}, nil)

		app := fiber.New()
		h := NewHandler(uc)
		app.Get("/{{ .Plural }}/:id", h.GetByID)

		resp, err := app.Test(httptest.NewRequest(http.MethodGet, "/{{ .Plural }}/id-1", nil))
		require.NoError(t, err)
		assert.Equal(t, http.StatusOK, resp.StatusCode)

		body := parseJSONBody(t, resp)
		assert.Equal(t, true, body["success"])
		uc.AssertExpectations(t)
	})

	t.Run("not_found", func(t *testing.T) {
		uc := new(mockUseCase)
		uc.On("GetByID", mock.Anything, "missing").Return(nil, apperr.NotFoundf("{{ .Name }} not found"))

		app := fiber.New()
		h := NewHandler(uc)
		app.Get("/{{ .Plural }}/:id", h.GetByID)

		resp, err := app.Test(httptest.NewRequest(http.MethodGet, "/{{ .Plural }}/missing", nil))
		require.NoError(t, err)
		assert.Equal(t, http.StatusNotFound, resp.StatusCode)
		uc.AssertExpectations(t)
	})
}

func TestHandler_List(t *testing.T) {
	uc := new(mockUseCase)
	uc.On("List", mock.Anything, mock.AnythingOfType("dto.List{{ .TitlePlural }}Request")).Return(
		shareddomain.CursorPage[dto.{{ .Title }}Response]{
			Items: []dto.{{ .Title }}Response{
				{ID: "id-1", Name: "first"},
			},
		}, nil,
	)

	app := fiber.New()
	h := NewHandler(uc)
	app.Get("/{{ .Plural }}", h.List)

	resp, err := app.Test(httptest.NewRequest(http.MethodGet, "/{{ .Plural }}?limit=10", nil))
	require.NoError(t, err)
	assert.Equal(t, http.StatusOK, resp.StatusCode)

	body := parseJSONBody(t, resp)
	assert.Equal(t, true, body["success"])
	uc.AssertExpectations(t)
}

func TestHandler_Create(t *testing.T) {
	t.Run("created", func(t *testing.T) {
		uc := new(mockUseCase)
		uc.On("Create", mock.Anything, dto.Create{{ .Title }}Request{Name: "alpha"}).Return(&dto.{{ .Title }}Response{
			ID:   "id-1",
			Name: "alpha",
		}, nil)

		app := fiber.New()
		h := NewHandler(uc)
		app.Post("/{{ .Plural }}", h.Create)

		req := httptest.NewRequest(http.MethodPost, "/{{ .Plural }}", bytes.NewBufferString(`{"name":"alpha"}`))
		req.Header.Set("Content-Type", "application/json")
		resp, err := app.Test(req)
		require.NoError(t, err)
		assert.Equal(t, http.StatusCreated, resp.StatusCode)
		uc.AssertExpectations(t)
	})

	t.Run("validation_error", func(t *testing.T) {
		app := fiber.New()
		h := NewHandler(new(mockUseCase))
		app.Post("/{{ .Plural }}", h.Create)

		req := httptest.NewRequest(http.MethodPost, "/{{ .Plural }}", bytes.NewBufferString(`{"name":""}`))
		req.Header.Set("Content-Type", "application/json")
		resp, err := app.Test(req)
		require.NoError(t, err)
		assert.Equal(t, http.StatusBadRequest, resp.StatusCode)
	})
}

