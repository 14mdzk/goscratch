-- name: Get{{ .Title }}ByID :one
SELECT id, name, created_at, updated_at
FROM {{ .Plural }}
WHERE id = $1;

-- name: List{{ .TitlePlural }} :many
SELECT id, name, created_at, updated_at
FROM {{ .Plural }}
WHERE (sqlc.narg(cursor)::uuid IS NULL OR id > sqlc.narg(cursor))
  AND (sqlc.narg(search)::text IS NULL OR name ILIKE '%' || sqlc.narg(search) || '%')
ORDER BY id ASC
LIMIT $1;

-- name: List{{ .TitlePlural }}Prev :many
SELECT id, name, created_at, updated_at
FROM {{ .Plural }}
WHERE (sqlc.narg(cursor)::uuid IS NULL OR id < sqlc.narg(cursor))
  AND (sqlc.narg(search)::text IS NULL OR name ILIKE '%' || sqlc.narg(search) || '%')
ORDER BY id DESC
LIMIT $1;

-- name: Create{{ .Title }} :one
INSERT INTO {{ .Plural }} (name)
VALUES ($1)
RETURNING id, name, created_at, updated_at;

-- name: Update{{ .Title }} :one
UPDATE {{ .Plural }}
SET name = COALESCE(NULLIF($2, ''), name),
    updated_at = NOW()
WHERE id = $1
RETURNING id, name, created_at, updated_at;

-- name: Delete{{ .Title }} :exec
DELETE FROM {{ .Plural }}
WHERE id = $1;
