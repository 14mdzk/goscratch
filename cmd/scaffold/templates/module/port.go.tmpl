package usecase

import (
	"context"

	"{{ .ModulePath }}/internal/module/{{ .Name }}/domain"
	"{{ .ModulePath }}/internal/module/{{ .Name }}/dto"
	shareddomain "{{ .ModulePath }}/internal/shared/domain"
)

// Repo is the narrow repository port that {{ .Name }}UseCase depends on.
// *repository.Repository satisfies it; unit tests inject a mock.
type Repo interface {
	GetByID(ctx context.Context, id string) (*domain.{{ .Title }}, error)
	List(ctx context.Context, filter domain.{{ .Title }}Filter) ([]domain.{{ .Title }}, error)
	Create(ctx context.Context, name string) (*domain.{{ .Title }}, error)
	Update(ctx context.Context, id, name string) (*domain.{{ .Title }}, error)
	Delete(ctx context.Context, id string) error
}

// UseCase defines the interface for {{ .Name }} business logic operations.
// Handlers and decorators depend on this interface rather than on the
// concrete *{{ .Name }}UseCase struct, enabling testability and extensibility.
type UseCase interface {
	GetByID(ctx context.Context, id string) (*dto.{{ .Title }}Response, error)
	List(ctx context.Context, req dto.List{{ .TitlePlural }}Request) (shareddomain.CursorPage[dto.{{ .Title }}Response], error)
	Create(ctx context.Context, req dto.Create{{ .Title }}Request) (*dto.{{ .Title }}Response, error)
	Update(ctx context.Context, id string, req dto.Update{{ .Title }}Request) (*dto.{{ .Title }}Response, error)
	Delete(ctx context.Context, id string) error
}
