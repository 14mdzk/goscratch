# Database
DB_PASSWORD=postgres

# JWT (CHANGE IN PRODUCTION)
JWT_SECRET=your-super-secret-key-change-in-production

# Optional services
REDIS_ENABLED=false
# Deprecated alias: when QUEUE_BACKEND is unset, true selects rabbitmq.
RABBITMQ_ENABLED=false
# Queue tier: goroutine (default, zero-infra), rabbitmq (durable), redis (reserved).
QUEUE_BACKEND=
# Consume jobs inside the API process. Required with the goroutine backend,
# forbidden with rabbitmq (run cmd/worker instead).
WORKER_IN_PROCESS=true
AUDIT_ENABLED=false
EMAIL_ENABLED=false
NOTIFICATION_ENABLED=false

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
